-# Inline branch chip + dropdown for the test_cases#show headline.
-# Same picker as commits/_branch_picker, but each option keeps the
-# user on the same test case (re-rendering its history on the chosen
-# branch) rather than dropping back to the commits index.
= render "commits/branch_picker",
         branch: @selected_branch,
         sections: [{ label: "Recently updated", branches: @recent_branches },
                    { label: "Older", branches: @older_branches }],
         link_for: ->(b) { test_case_path(branch: b.name, module: @test_case.module, test_case: @test_case.name) },
         wrapper_class: "align-middle"
