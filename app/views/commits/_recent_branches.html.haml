-# Shortcut cards for the branches tested most recently (excluding
-# the one on screen), so the index doubles as a jumping-off point
-# for wherever development is happening. Each card offers the
-# branch's commit list and its head commit, with the head's status
-# ring for an at-a-glance read.
-#
-# Locals:
-#   entries: output of Branch.recently_tested — [{ branch:, last_tested_at: }].
- return if entries.blank?
%section{ "aria-label": "Recently tested branches" }
  %h2.mesa-label.mb-2 Recently tested branches
  .grid.gap-3{ class: "grid-cols-1 sm:grid-cols-3" }
    - entries.each do |entry|
      - branch = entry[:branch]
      - head = branch.head
      .rounded-lg.border.border-border.bg-bg-elev.p-3.flex.flex-col.gap-2.min-w-0{ style: "box-shadow: var(--shadow-card-sm);" }
        .flex.items-baseline.justify-between.gap-2.min-w-0
          = link_to commits_path(branch: branch.name), class: "inline-flex items-center gap-1 min-w-0 font-mono text-[13px] text-fg no-underline hover:text-brand", title: branch.name do
            = mesa_icon(:branch, size: 12)
            %span.truncate= branch.name
          %span.shrink-0.text-fg-subtle.tabular-nums{ class: "text-[11px]", title: entry[:last_tested_at].in_time_zone.to_s }
            = "tested #{time_ago_compact(entry[:last_tested_at])}"
        .flex.items-center.gap-2.min-w-0
          = render "status_ring", state: head.commit_state, size: 24
          .min-w-0.flex.flex-col
            %span.font-mono.text-brand{ class: "text-[11px]" }= head.short_sha
            %span.truncate.text-fg-muted{ class: "text-[12px]", title: head.message_first_line(200) }= head.message_first_line(80)
        .flex.items-center.gap-2.text-xs
          = link_to "Commits", commits_path(branch: branch.name), class: "mesa-btn"
          = link_to "Head commit", commit_path(branch: branch.name, sha: head.short_sha), class: "mesa-btn"
