-# The commit list card shared by the per-branch commits index and the
-# home page's per-branch sections: a column header, then one row per
-# commit (a stacked card below sm, a 7-column grid above), grouped
-# under age headers. The rows themselves live in `_commit_rows`, so
-# the home page's unified view can append pages of them under one
-# header.
-#
-# Locals:
-#   commits:       Commits to list, newest first.
-#   empty_message: Shown in place of rows when commits is empty.
-#   when_anchor, when_mode: as in `_commit_rows`.
-#   when_header:   Optional column label overriding "When", and
-#   when_title:    its tooltip.
-#   rows:          Optional HTML to place under the header instead of
-#                  rendering `commits` (the unified view's lazy frame).
-#   ...plus every `_commit_rows` local, passed straight through.
- when_header = local_assigns[:when_header]
- when_title = local_assigns[:when_title]
.rounded-lg.border.border-border.bg-bg-elev{ style: "box-shadow: var(--shadow-card-sm);" }
  -# Table header — hidden on narrow viewports where the table layout
  -# breaks down and the mobile card layout below takes over.
  .hidden.gap-3.border-b.border-border-subtle.bg-bg-subtle.px-4.py-2.font-semibold.uppercase.tracking-wide.text-fg-subtle{ class: "text-[10px] sm:grid grid-cols-[30px_minmax(0,2.4fr)_minmax(0,1.2fr)_minmax(0,1.4fr)_minmax(0,1.4fr)_minmax(0,2.6fr)_minmax(0,0.8fr)]" }
    %span &nbsp;
    %span Commit
    %span SHA
    %span Author
    %span Build
    %span Tests
    %span.text-right.whitespace-nowrap{ title: when_title || (when_mode == :now ? "How long ago each commit was made" : "Time before the end of #{when_anchor.strftime('%b %-d, %Y')}") }= when_header || commit_when_header(anchor: when_anchor, mode: when_mode)

  - if local_assigns[:rows]
    = rows
  - elsif commits.empty?
    .px-4.py-10.text-center.text-sm.text-fg-muted
      = empty_message
  - else
    = render "commits/commit_rows", **local_assigns.except(:empty_message, :when_header, :when_title, :rows)
