- content_for :title, "Recent activity"

- default_days = CommitsController::HOME_DEFAULT_DAYS
- view_param = @view == :unified ? "unified" : nil
- days_param = @days == default_days ? nil : @days

.space-y-8{ data: { controller: "prefetch-frames" } }
  -# Headline + view and window chips. The chips are plain links
  -# (?view=unified, ?days=N) that keep each other's setting, so any
  -# combination is bookmarkable; a hand-typed ?days= outside the chip
  -# set still works and simply leaves no window chip highlighted.
  %header.flex.flex-wrap.items-end.justify-between.gap-x-6.gap-y-3
    .flex.flex-col.gap-2.min-w-0
      %h1.text-2xl.font-semibold.tracking-tight.text-fg Recent activity
      %p.text-xs.text-fg-muted
        - if @view == :unified
          = "#{pluralize(@unified_count, 'commit')} pushed to #{pluralize(@sections.size, 'branch')} in the last #{pluralize(@days, 'day')}, newest push first"
        - else
          = "#{pluralize(@sections.size, 'branch')} pushed to in the last #{pluralize(@days, 'day')}, most recent first"
    .flex.flex-wrap.items-center.gap-x-4.gap-y-2.text-xs.shrink-0.ml-auto
      %nav.flex.items-center.gap-1{ "aria-label": "View" }
        %span.mesa-label.mr-1 View
        - [[nil, "Branches"], ["unified", "Unified"]].each do |value, label|
          - active = value == view_param
          = link_to label, root_path(view: value, days: days_param),
                    class: "mesa-btn #{'border-brand text-brand' if active}",
                    aria: { current: (active ? "true" : nil) }
      %nav.flex.items-center.gap-1{ "aria-label": "Time window" }
        %span.mesa-label.mr-1 Window
        - CommitsController::HOME_WINDOW_CHOICES.each do |d|
          - active = d == @days
          = link_to "#{d}d", root_path(view: view_param, days: (d == default_days ? nil : d)),
                    class: "mesa-btn #{'border-brand text-brand' if active}",
                    aria: { current: (active ? "true" : nil) }

  - if @sections.empty?
    .rounded-lg.border.border-border.bg-bg-elev.px-4.py-10.text-center.text-sm.text-fg-muted
      = "No branches have been pushed to in the last #{pluralize(@days, 'day')}."
      = link_to "Browse commits on main →", commits_path(branch: "main")
  - elsif @view == :unified
    -# One table for every branch's new commits, newest push first. The
    -# header renders here; pages of rows arrive in a lazy frame (see
    -# commits#home_unified) and stack up via each page's "Show more".
    - placeholder = content_tag(:div, "Loading commits…", class: "flex items-center justify-center px-4 text-sm text-fg-subtle", style: "min-height: #{[@unified_count, CommitsController::HOME_UNIFIED_PAGE].min * 57 + 40}px;")
    - frame = turbo_frame_tag("home_unified_0", src: home_unified_path(days: @days, offset: 0), loading: "lazy", target: "_top", class: "block") { placeholder }
    = render "commit_table", when_anchor: Time.zone.now, when_mode: :now, when_header: "Pushed", when_title: "How long ago each commit was first pushed", rows: frame
  - else
    - @sections.each do |section|
      - branch = section[:branch]
      - commit_count = section[:commit_ids].size
      %section.space-y-2{ "aria-label": "Commits on #{branch.name}" }
        -# Branch heading: the name links to the branch's full commits
        -# index; the meta line says when it was last pushed and how many
        -# commits arrived in the window.
        .flex.flex-wrap.items-baseline.justify-between.gap-x-4.gap-y-1.border-b.border-border-subtle.pb-2
          %h2.min-w-0
            = link_to commits_path(branch: branch.name), class: "group/branch inline-flex items-center gap-1.5 min-w-0 font-mono text-base font-semibold text-fg no-underline hover:text-brand", title: "All commits on #{branch.name}" do
              = mesa_icon(:branch, size: 14)
              %span.truncate{ class: "group-hover/branch:underline" }= branch.name
          %p.text-fg-subtle.tabular-nums{ class: "text-[11px]" }
            %span{ title: section[:last_pushed_at].in_time_zone(time_zone).to_s }= "pushed #{time_ago_compact(section[:last_pushed_at])}"
            %span.mx-1 ·
            = "#{pluralize(commit_count, 'new commit')}"
            %span.mx-1 ·
            = link_to "All commits →", commits_path(branch: branch.name), class: "text-brand no-underline hover:underline"

        -# Lazy frame: the table (and its commit_state work) loads as the
        -# section scrolls into view, collapsed to the newest few commits
        -# with a toggle for more. The placeholder reserves roughly the
        -# collapsed height so the page doesn't jump much as frames fill.
        = turbo_frame_tag "home_section_#{branch.id}", src: home_section_path(branch: branch.name, days: @days), loading: "lazy", target: "_top" do
          .rounded-lg.border.border-border.bg-bg-elev.px-4.text-sm.text-fg-subtle.flex.items-center.justify-center{ style: "box-shadow: var(--shadow-card-sm); min-height: #{[commit_count, CommitsController::HOME_COMMITS_COLLAPSED].min * 57 + 90}px;" }
            Loading commits…

