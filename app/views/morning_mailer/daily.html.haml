-# Daily digest email body. Layout chrome (table wrappers, dark-mode
-# style block) lives in app/views/layouts/morning_mailer.html.haml.
-#
-# Inline styles throughout: most email clients strip <style> blocks.
-# Order: header (counts + what needs attention), performance
-# anomalies, then every commit once, grouped main → related-branch
-# families → single branches → unattached (see MorningReport).

- zone = MorningReport::ZONE
- window_from = @report.window_start.in_time_zone(zone)
- window_to = @report.window_end.in_time_zone(zone)
- attention = @report.attention_summaries
- card_style = "background:#ffffff; border:1px solid #d8dde4; border-radius:10px;"
- label_style = "font-size:10px; font-weight:600; text-transform:uppercase; letter-spacing:0.06em; color:#57606a;"

-# ===== Header card =====
%table.mesa-card{ role: "presentation", width: "100%", cellspacing: "0", cellpadding: "0", border: "0", style: card_style }
  %tr
    %td{ style: "padding:20px 24px 18px 24px;" }
      %table{ role: "presentation", width: "100%", cellspacing: "0", cellpadding: "0", border: "0" }
        %tr
          %td.mesa-wordmark-text{ style: "color:#1f2328; font-size:13px; font-weight:600;" }
            %span{ style: "color:#3a56fd; font-weight:700; letter-spacing:0.2px;" } MESA Test Hub
            %span.mesa-fg-subtle{ style: "color:#8b949e; font-weight:400; padding-left:8px;" } daily digest
          %td.mesa-fg-muted{ style: "color:#57606a; font-size:12px; text-align:right;" }
            = @date.strftime('%A, %B %-d, %Y')

      %div.mesa-fg{ style: "margin-top:18px; font-size:22px; font-weight:600; letter-spacing:-0.01em; color:#1f2328;" }
        - if @report.any_commits?
          = pluralize(@report.commits_tested.size, 'commit')
          tested in the last 24 hours
        - else
          No new test runs in the last 24 hours
      %div.mesa-fg-muted{ style: "margin-top:4px; font-size:12px; color:#57606a;" }
        Results from #{window_from.strftime('%a %-l:%M %p')} to #{window_to.strftime('%a %-l:%M %p %Z')}

      - if @report.any_commits?
        -# Stat strip.
        %table{ role: "presentation", width: "100%", cellspacing: "0", cellpadding: "0", border: "0", style: "margin-top:16px;" }
          %tr
            - tiles = [["Commits tested", @report.commits_tested.size, false], ["Need attention", attention.size, attention.any?], ["Computers reporting", @report.computers_reporting, false]]
            - tiles.each_with_index do |(label, value, alarm), i|
              - pad = i.zero? ? "padding-right:8px;" : (i == tiles.size - 1 ? "padding-left:8px;" : "padding:0 4px;")
              %td.mesa-stat-cell.mesa-stack-on-mobile{ width: "33%", valign: "top", style: pad }
                %table.mesa-card-subtle{ role: "presentation", width: "100%", cellspacing: "0", cellpadding: "0", border: "0", style: "background:#f7f8fa; border:1px solid #e6e8ec; border-radius:8px;" }
                  %tr
                    %td{ style: "padding:12px 14px;" }
                      %div.mesa-fg-muted{ style: label_style }= label
                      %div{ class: (alarm ? nil : "mesa-stat-num"), style: "margin-top:4px; font-size:24px; font-weight:600; color:#{alarm ? '#a40e26' : '#1f2328'};" }= value

        -# What needs attention, each commit once, worst first. Full
        -# details are in the commit's section below.
        - if attention.any?
          %div.mesa-fg-muted{ style: "margin-top:18px; #{label_style}" } Needs attention
          %table{ role: "presentation", width: "100%", cellspacing: "0", cellpadding: "0", border: "0", style: "margin-top:6px;" }
            - attention.first(12).each do |cs|
              %tr
                %td{ valign: "top", style: "padding:5px 8px 5px 0; white-space:nowrap; width:1%;" }
                  = mailer_sha_pill(cs.commit)
                %td{ valign: "top", style: "padding:5px 0; font-size:13px; overflow-wrap:anywhere; word-break:break-word;" }
                  = mailer_link_or_text(mailer_message_excerpt(cs.commit, length: 60), mailer_commit_url(cs), style: "color:#1f2328; text-decoration:none;")
                  %div{ style: "margin-top:2px;" }
                    = mailer_build_badge(cs)
                    - unless cs.tests_status == :not_run && cs.build_failed?
                      = mailer_tests_pill(cs)
                    %span.mesa-fg-subtle{ style: "color:#8b949e; font-size:11px; padding-left:4px; overflow-wrap:anywhere; word-break:break-word;" }= cs.link_branch_name || "no branch"
          - if attention.size > 12
            %div.mesa-fg-subtle{ style: "margin-top:4px; font-size:11px; color:#8b949e;" }
              and #{attention.size - 12} more below.
        - else
          %div.mesa-fg-muted{ style: "margin-top:14px; font-size:13px; color:#57606a;" }
            Nothing failed. Everything that ran is passing or still in progress.

      %div.mesa-fg-muted{ style: "margin-top:14px; font-size:12px; color:#57606a;" }
        - case @report.release_blocker_count
        - when nil
          %span.mesa-fg-subtle{ style: "color:#8b949e;" }
            Release blockers: couldn't check (no GitHub API access in this environment).
        - when 0
          No open release-blocker issues on GitHub.
        - else
          %strong{ style: "color:#a40e26;" }
            = pluralize(@report.release_blocker_count, 'open release-blocker')
          on GitHub.

-# ===== Anomalies =====
- if @report.any_anomalies?
  %div{ style: "height:16px;" }
  %table.mesa-card{ role: "presentation", width: "100%", cellspacing: "0", cellpadding: "0", border: "0", style: card_style }
    %tr
      %td{ style: "padding:18px 24px;" }
        %table{ role: "presentation", width: "100%", cellspacing: "0", cellpadding: "0", border: "0" }
          %tr
            %td.mesa-fg{ style: "color:#1f2328; font-size:13px; font-weight:600; letter-spacing:0.02em; text-transform:uppercase;" }
              Performance anomalies
            %td.mesa-fg-muted{ style: "color:#57606a; font-size:11px; text-align:right;" }
              = @report.anomalies.size
        %div.mesa-fg-muted{ style: "margin-top:4px; font-size:12px; color:#57606a;" }
          Passing runs much slower or bigger than the last 50 passing runs of the same test on the same computer, set up the same way (inlists, FPE checks, resolution, threads). Each test name links to that history.

        %table{ role: "presentation", width: "100%", cellspacing: "0", cellpadding: "0", border: "0", style: "margin-top:10px;" }
          - @report.anomalies.first(15).each_with_index do |anomaly, i|
            - ti = anomaly.test_instance
            %tr
              %td{ style: "padding:8px 0; #{i.zero? ? '' : 'border-top:1px solid #eceef2;'}" }
                %table{ role: "presentation", width: "100%", cellspacing: "0", cellpadding: "0", border: "0" }
                  %tr
                    %td{ valign: "top", style: "padding-right:8px; font-size:13px; overflow-wrap:anywhere;" }
                      = link_to ti.test_case.name, mailer_anomaly_cohort_url(anomaly), class: "mesa-link mesa-fg", style: "color:#1f2328; text-decoration:none; font-weight:600; font-family:ui-monospace,SFMono-Regular,Menlo,monospace;"
                      %span.mesa-fg-muted{ style: "color:#57606a; font-size:12px; padding-left:4px;" }
                        on
                        %strong.mesa-fg{ style: "color:#1f2328; font-weight:600;" }= ti.computer.name
                    %td{ valign: "top", align: "right", style: "white-space:nowrap; font-size:13px;" }
                      %strong{ style: "color:#a40e26;" } ×#{format('%.1f', anomaly.ratio)}
                  %tr
                    %td.mesa-fg-muted{ colspan: "2", style: "padding-top:2px; font-size:12px; color:#57606a;" }
                      #{anomaly.label}
                      %strong.mesa-fg{ style: "color:#1f2328;" }= mailer_anomaly_value(anomaly, anomaly.value)
                      vs. usual #{mailer_anomaly_value(anomaly, anomaly.cohort_mean)}
                      %span{ style: "padding:0 4px; color:#8b949e;" } ·
                      - if anomaly.occurrences.to_i > 1
                        on #{anomaly.occurrences} commits, worst
                      %code{ style: "font-family:ui-monospace,SFMono-Regular,Menlo,monospace;" }= ti.commit.short_sha
        - if @report.anomalies.size > 15
          %div.mesa-fg-subtle{ style: "margin-top:6px; font-size:11px; color:#8b949e;" }
            (#{@report.anomalies.size - 15} more in the web view.)

-# ===== Sections: every commit once =====
- @report.sections.each do |section|
  %div{ style: "height:16px;" }
  %table.mesa-card{ role: "presentation", width: "100%", cellspacing: "0", cellpadding: "0", border: "0", style: card_style }
    %tr
      %td{ style: "padding:18px 24px 6px 24px;" }
        %table{ role: "presentation", width: "100%", cellspacing: "0", cellpadding: "0", border: "0" }
          %tr
            %td.mesa-fg{ style: "color:#1f2328; font-size:13px; font-weight:600; letter-spacing:0.02em; overflow-wrap:anywhere; word-break:break-word;" }
              = section.title
            %td.mesa-fg-muted{ valign: "top", style: "color:#57606a; font-size:11px; text-align:right; padding-left:8px;" }
              = pluralize(section.commit_count, 'commit')
              - if section.attention_count.positive?
                %span{ style: "color:#a40e26; font-weight:600;" } · #{section.attention_count} #{section.attention_count == 1 ? 'needs' : 'need'} attention
        - case section.kind
        - when :family
          %div.mesa-fg-muted{ style: "margin-top:4px; font-size:11px; color:#57606a; word-break:break-word;" }
            Branches that share commits; each commit is listed once.
            %br
            %span.mesa-fg-subtle{ style: "color:#8b949e; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; overflow-wrap:anywhere;" }= mailer_branch_list(section.branch_names)
        - when :unattached
          %div.mesa-fg-muted{ style: "margin-top:4px; font-size:11px; color:#8b949e;" }
            On no branch — typically PR test-merge commits, or pushes whose branch sync hasn't landed yet. These have no commit page.

    - section.current_summaries.each_with_index do |cs, i|
      = render "morning_mailer/commit_row", cs: cs, first: i.zero?, section: section

    - if section.rewritten_summaries.any?
      %tr
        %td{ style: "padding:6px 24px 0 24px;" }
          %div.mesa-divider{ style: "border-top:1px solid #eceef2;" }
          %div.mesa-fg-muted{ style: "margin-top:10px; #{label_style}" }
            Rebased away (#{section.rewritten_summaries.size})
          %div.mesa-fg-subtle{ style: "margin-top:2px; font-size:11px; color:#8b949e;" }
            Tested before a force-push replaced them. Not counted as needing attention.
          %table{ role: "presentation", width: "100%", cellspacing: "0", cellpadding: "0", border: "0", style: "margin-top:4px;" }
            - section.rewritten_summaries.first(10).each do |cs|
              %tr
                %td{ valign: "top", style: "padding:3px 8px 3px 0; white-space:nowrap; width:1%;" }
                  = mailer_sha_pill(cs.commit)
                %td{ valign: "top", style: "padding:3px 8px 3px 0; font-size:12px; overflow-wrap:anywhere; word-break:break-word;" }
                  = mailer_link_or_text(mailer_message_excerpt(cs.commit, length: 60), mailer_commit_url(cs), style: "color:#57606a; text-decoration:none;")
                  - if cs.replacement
                    %span.mesa-fg-subtle{ style: "color:#8b949e; font-size:11px;" } → #{cs.replacement.short_sha}
                %td{ valign: "top", align: "right", style: "padding:3px 0; white-space:nowrap;" }
                  = mailer_tests_pill(cs)
          - if section.rewritten_summaries.size > 10
            %div.mesa-fg-subtle{ style: "margin-top:2px; font-size:11px; color:#8b949e;" }
              and #{section.rewritten_summaries.size - 10} more.

    %tr
      %td{ style: "padding:0 24px 12px 24px;" }
